// Thanks to Joel Yliluoma for your awesome page on dithering!
// Gamma correction and differenceFactor concepts were huge additions
// https://bisqwit.iki.fi/story/howto/dither/jy/

// This compute shader builds a 3D color lookup table (LUT) for ordered dithering.
// For every possible RGB input color, it finds the best pair of palette colors to
// dither between, along with the mix ratio. The result is two 3D textures that a
// screen-space dither shader can sample at runtime to produce a palette-constrained,
// dithered image in real time.

#pragma kernel CSMain

float size;             // Dimension of the 3D LUT (each axis goes from 0..size-1)
float differenceFactor; // Penalty weight for choosing two dissimilar dither colors,
                        // encouraging pairs that are close together for subtler dithering
float gamma;            // Gamma exponent for perceptually correct color blending
int paletteLength;      // Number of entries in the pre-computed dither palette

RWTexture3D<float4> PrimaryResult;   // Output LUT: primary dither color (alpha = 1 - ratio)
RWTexture3D<float4> SecondaryResult; // Output LUT: secondary dither color (alpha = ratio)

// Each palette entry is a candidate dither pair: two colors and a blend ratio
struct Dithered {
	float4 primary;
	float4 secondary;
	float ratio;
};
RWStructuredBuffer<Dithered> palette;

// Squared Euclidean distance between two colors in RGB space
float colDiff(float3 c1, float3 c2) {
	return (c1.x - c2.x)*(c1.x - c2.x) + (c1.y - c2.y)*(c1.y - c2.y) + (c1.z - c2.z)*(c1.z - c2.z);
}

// Convert from linear/display space into gamma-corrected space for perceptual blending
float3 adjustGamma(float3 c) {
	return float3(pow(abs(c.x), gamma), pow(abs(c.y), gamma), pow(abs(c.z), gamma));
}

// Convert back from gamma-corrected space to linear/display space
float3 unadjustGamma(float3 c) {
	return float3(pow(abs(c.x), 1.0 / gamma), pow(abs(c.y), 1.0 / gamma), pow(abs(c.z), 1.0 / gamma));
}

// Blend a dither pair's two colors by the given ratio in gamma-correct space,
// returning the perceptually accurate mixed color
float3 mix(Dithered col) {
	float3 gA = adjustGamma(col.primary.xyz);
	float3 gB = adjustGamma(col.secondary.xyz);
	return unadjustGamma(gB + (gA-gB) * col.ratio);
}

[numthreads(8,8,8)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
	// Map thread ID to an RGB color in [0,1] — this is the input color we're finding a match for
	float3 col = float3(id.x / (size-1.0), id.y / (size - 1.0), id.z / (size - 1.0));

	float3 primary = float3(1.0, 1.0, 1.0);
	float3 secondary = float3(1.0, 1.0, 1.0);
	float ratio = 1.0;
	float dist = 100000000000.0;

	// Search all palette entries to find the dither pair whose blended color is closest
	// to the input color. The differenceFactor term penalizes pairs with very different
	// colors, favoring smoother dither patterns at the cost of slightly less accurate color.
	for (int i = 0; i < paletteLength; i++) {
		float diff = colDiff(col, mix(palette[i])) + colDiff(palette[i].primary.xyz,palette[i].secondary.xyz)*differenceFactor;
		if (diff < dist ) {
			primary = palette[i].primary.xyz;
			secondary = palette[i].secondary.xyz;
			ratio = palette[i].ratio;
			dist = diff;
		}
	}

	// Write the winning dither pair into the two 3D LUT textures.
	// The alpha channels encode the ratio so the runtime dither shader knows
	// the threshold at which to pick primary vs secondary.
    PrimaryResult[id.xyz] = float4(primary.x,primary.y,primary.z,1.0-ratio);
	SecondaryResult[id.xyz] = float4(secondary.x,secondary.y,secondary.z,ratio);
}